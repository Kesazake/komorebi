---
import SiteFooter from '../components/layout/SiteFooter.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import { siteTagline, siteTitle } from '../lib/site';
import Base from './Base.astro';

interface Props {
  title?: string | undefined;
}

const { title } = Astro.props;
---

<Base {title}>
  <div class="komorebi-background pointer-events-none fixed inset-0 -z-10"></div>
  <SiteHeader {siteTitle} tagline={siteTagline} />

  <main
    class="mx-auto w-full max-w-7xl flex-1 px-6 py-10 sm:px-8 lg:px-10 lg:py-14"
  >
    <slot />
  </main>

  <SiteFooter />
</Base>
