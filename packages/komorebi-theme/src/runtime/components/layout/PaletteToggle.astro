---
/**
 * 配色切换开关
 *
 * 只在 palette 列表长度 > 1 时渲染。
 * 切换是**无刷新**的：所有颜色都是 CSS 变量，改 <html data-palette> 即可。
 * 同时同步 <meta name="theme-color"> 与 localStorage。
 *
 * 首屏防闪烁在 Base.astro 的 <head> 内联脚本里处理。
 */

interface Props {
  current: string;
  options: string[];
  themeColors: Record<string, string>;
  /** 紧凑模式：用于移动端下拉菜单里的整行条目 */
  variant?: 'icon' | 'row';
}

const {
  current,
  options,
  themeColors,
  variant = 'icon',
} = Astro.props as Props;

const labels: Record<string, string> = {
  sun: '浅色（木漏れ日）',
  moon: '深色（月影）',
};

const label = labels[current] ?? current;
const isIcon = variant === 'icon';
---

{
  options.length > 1 && (
    <button
      type="button"
      class:list={[
        'palette-toggle cursor-pointer transition duration-200',
        isIcon
          ? 'flex h-9 w-9 -translate-y-1 items-center justify-center rounded-full text-zinc-500 hover:bg-zinc-950/5 hover:text-zinc-950'
          : 'flex w-full items-center gap-3 rounded-xl px-3 py-2 text-left text-zinc-600 hover:bg-zinc-50 hover:text-zinc-950',
      ]}
      data-palette-toggle
      data-palettes={JSON.stringify(options)}
      data-theme-colors={JSON.stringify(themeColors)}
      aria-label={`切换配色（当前：${label}）`}
      title={`当前配色：${label}`}
    >
      <span class="palette-toggle__icon" aria-hidden="true">
        <svg
          class="palette-toggle__sun"
          width="1.05em"
          height="1.05em"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
        <svg
          class="palette-toggle__moon"
          width="1.05em"
          height="1.05em"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
        </svg>
      </span>
      {!isIcon && <span data-palette-label>{label}</span>}
    </button>
  )
}

<style>
  /* 太阳 / 月亮二选一，避免按钮宽度跳动 */
  .palette-toggle__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .palette-toggle__sun,
  .palette-toggle__moon {
    display: block;
  }

  .palette-toggle__moon {
    display: none;
  }

  :root[data-palette='moon'] .palette-toggle__sun {
    display: none;
  }

  :root[data-palette='moon'] .palette-toggle__moon {
    display: block;
  }
</style>


