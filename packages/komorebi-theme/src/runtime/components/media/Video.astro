---
/**
 * 媒体组件：视频
 *
 * 用于 MDX 文章中嵌入视频，替代裸 <video> 标签。
 * 自动套用与正文图片一致的圆角、边框、阴影与间距。
 *
 * 用法（MDX）：
 *   import { Video } from 'komorebi-theme/components';
 *   import clip from './assets/demo.mp4';
 *
 *   <Video src={clip} />
 *   <Video src={clip} poster={cover} caption="现场记录" />
 */

interface Props {
  /** 视频地址，支持 import 导入的本地文件 */
  src: string;
  /** 封面图，视频加载前或暂停时显示 */
  poster?: string | undefined;
  /** 图注，显示在媒体下方；也用于说明音频/视频的内容 */
  caption?: string | undefined;
  /** 控制条，默认显示 */
  controls?: boolean | undefined;
  /** 自动播放；浏览器要求同时 muted 才会生效 */
  autoplay?: boolean | undefined;
  /** 循环播放 */
  loop?: boolean | undefined;
  /** 静音 */
  muted?: boolean | undefined;
  /** 宽度，默认撑满容器 */
  width?: string | undefined;
  /** 额外的 class */
  class?: string | undefined;
}

const {
  src,
  poster,
  caption,
  controls = true,
  autoplay = false,
  loop = false,
  muted = false,
  width,
  class: className,
} = Astro.props as Props;
---

<figure class:list={['komorebi-media', className]}>
  <video
    class="komorebi-media__el"
    src={src}
    poster={poster}
    controls={controls}
    autoplay={autoplay}
    loop={loop}
    muted={muted}
    playsinline
    preload="metadata"
    style={width ? `width:${width}` : undefined}
  >
  </video>
  {
    caption && (
      <figcaption class="komorebi-media__caption">{caption}</figcaption>
    )
  }
</figure>
